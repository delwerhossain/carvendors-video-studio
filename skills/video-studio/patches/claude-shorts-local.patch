diff --git a/scripts/captions.py b/scripts/captions.py
index 1e11d84..2b560ca 100644
--- a/scripts/captions.py
+++ b/scripts/captions.py
@@ -93,6 +93,8 @@ def tracking(style):
 
 def text_width(txt, style):
     f = F[style]
+    if not txt.isascii():  # local patch: complex scripts (Bengali) are drawn as one shaped run, no tracking
+        return f.getlength(txt)
     return f.getlength(txt) + tracking(style) * (len(txt) - 1)
 
 
@@ -105,6 +107,8 @@ def line_metrics(style):
 def draw_text(d, x, baseline, txt, style, **kw):
     """Draw with tracking while keeping kerning: char x = getlength(prefix) + i*tracking."""
     f = F[style]; tr = tracking(style)
+    if not txt.isascii():  # local patch: per-char drawing breaks Bengali conjuncts and vowel signs
+        d.text((x, baseline), txt, font=f, anchor="ls", **kw); return
     for i, ch in enumerate(txt):
         d.text((x + f.getlength(txt[:i]) + i * tr, baseline), ch, font=f, anchor="ls", **kw)
 
